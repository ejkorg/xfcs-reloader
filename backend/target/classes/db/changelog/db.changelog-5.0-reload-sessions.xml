<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5.0.1-create-reload-sessions" author="xfcs-reloader">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="xfcs_dearchiver_reload_sessions" />
            </not>
        </preConditions>

        <createTable tableName="xfcs_dearchiver_reload_sessions">
            <column name="session_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="requester" type="VARCHAR(255)"/>
            <column name="environment" type="VARCHAR(255)"/>
            <column name="site" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="message" type="VARCHAR(4000)"/>
            <column name="file_count" type="INT"/>
            <column name="total_bytes" type="BIGINT"/>
            <column name="details" type="CLOB"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="xfcs_dearchiver_reload_sessions" indexName="idx_xfcs_rs_requester">
            <column name="requester"/>
        </createIndex>
        <createIndex tableName="xfcs_dearchiver_reload_sessions" indexName="idx_xfcs_rs_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="xfcs_dearchiver_reload_sessions" indexName="idx_xfcs_rs_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
