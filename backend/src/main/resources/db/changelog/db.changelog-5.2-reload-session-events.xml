<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5.2.1-create-reload-session-events" author="xfcs-reloader">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="xfcs_dearchiver_reload_session_events"/>
            </not>
        </preConditions>

        <createTable tableName="xfcs_dearchiver_reload_session_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="event_time" type="TIMESTAMP"/>
            <column name="event_type" type="VARCHAR(128)"/>
            <column name="message" type="VARCHAR(4000)"/>
            <column name="actor" type="VARCHAR(255)"/>
            <column name="error_code" type="VARCHAR(64)"/>
        </createTable>

        <createIndex tableName="xfcs_dearchiver_reload_session_events" indexName="idx_xfcs_rse_session">
            <column name="session_id"/>
        </createIndex>

        <createIndex tableName="xfcs_dearchiver_reload_session_events" indexName="idx_xfcs_rse_time">
            <column name="event_time"/>
        </createIndex>

        <createIndex tableName="xfcs_dearchiver_reload_session_events" indexName="idx_xfcs_rse_type">
            <column name="event_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
