<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5.1.1-add-area-tester-type-columns" author="xfcs-reloader">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="xfcs_dearchiver_reload_sessions" columnName="area"/>
            </not>
        </preConditions>

        <addColumn tableName="xfcs_dearchiver_reload_sessions">
            <column name="area" type="VARCHAR(255)"/>
            <column name="tester_type" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex tableName="xfcs_dearchiver_reload_sessions" indexName="idx_xfcs_rs_site_area">
            <column name="site"/>
            <column name="area"/>
        </createIndex>

        <createIndex tableName="xfcs_dearchiver_reload_sessions" indexName="idx_xfcs_rs_environment">
            <column name="environment"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
